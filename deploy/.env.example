# Written by deploy/deploy.sh on the VPS at /docker/csca-prep/.env — never committed.
DB_USER=csca
DB_PASSWORD=CHANGE_ME
DB_NAME=cscamaster
# At least 32 characters. The app refuses to start with a shorter value or
# with the example secret from .env.example — anyone who copies it can forge
# an admin session. Generate one with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_BYTES_HEX
APP_URL=https://www.cscamaster.com
SITE_NAME=CSCA Master
# Email OTP via resend.com. Verify the sending domain (DNS) and set:
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=CSCA Master <noreply@cscamaster.com>
# Required before running `npm run db:seed` against production. The seed
# refuses to create or reset the demo admin account without it.
# SEED_ADMIN_PASSWORD=change-me
# Optional: if set, `deploy/deploy.sh` applies the Cloudflare cache rule
# automatically after each deploy (Zone -> Cache Rules -> Edit).
# CLOUDFLARE_API_TOKEN=
# Optional EPay fallback (when no PaymentMethod rows are configured in /admin/payments):
# EPAY_URL=https://gw28.001cyy.com/
# EPAY_PID=
# EPAY_KEY=
# EPAY_TYPE=alipay
# EPAY_NAME=支付宝 Pay
# EPAY_ICON=
# EPAY_NOTIFY_DOMAIN=https://www.cscamaster.com
# EPAY_FEE_PERCENT=0
# EPAY_FEE_FIXED_CENTS=0
