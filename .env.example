# ── Database ────────────────────────────────────────────────────────────────
# Local development uses an embedded Postgres-compatible engine (PGlite) that
# `npm run dev` starts automatically. Nothing to install.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/postgres"

# Production: point this at a managed Postgres (Neon, Supabase, RDS…)
# DATABASE_URL="postgresql://user:password@host:5432/cscamaster?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="dev-only-change-me-0123456789abcdef0123456789abcdef"

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://www.cscamaster.com"
NEXT_PUBLIC_SITE_NAME="CSCA Master"
