generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── People ───────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String?
  role         String   @default("STUDENT") // STUDENT | ADMIN
  status       String   @default("APPROVED") // PENDING | APPROVED | REJECTED
  reviewedAt   DateTime?
  reviewedBy   String?
  emailVerifiedAt       DateTime?
  whatsappVerifiedAt    DateTime?
  country      String?
  whatsapp     String?
  track        String? // HUMANITIES | STEM (CN sub-track)
  targetYear   Int      @default(2027)
  testLanguage String   @default("en") // legacy interface language (deprecated → uiLocale)
  uiLocale     String   @default("en") // interface language: en | zh
  teachingTrack String  @default("EN") // EN | CN — which exams this student sits
  plan         String   @default("FREE") // FREE | PRO | LIFETIME
  proExpiresAt DateTime?
  // Bumped to invalidate every issued session (password change, forced
  // logout). The value is embedded in the JWT and checked on every request.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attempts    Attempt[]
  reviews     ReviewItem[]
  planTasks   PlanTask[]
  redemptions Redemption[]
  orders      Order[]
  conceptProgress ConceptProgress[]
  dailyQuizCompletions DailyQuizCompletion[]
  practiceActivities   PracticeActivity[]

  // Engagement / leaderboard (opt-in)
  leaderboardOptIn Boolean @default(false)
  leaderboardName  String?

  @@index([createdAt])
  @@index([plan])
  @@index([status])
}

// ─────────────────────────── Learning ───────────────────────────

model ConceptProgress {
  id          String   @id @default(cuid())
  userId      String
  topicCode   String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicCode])
  @@index([userId])
}

// ─────────────────────────── Rate limiting ───────────────────────────

/// Fixed-window counters for abuse controls (sign-in, OTP, lead capture).
/// Backed by Postgres so a restart or a second container does not reset a
/// throttle. Rows are tiny and are overwritten in place.
model RateLimit {
  key       String   @id // e.g. "signin:203.0.113.7" or "signin:203.0.113.7:user@x.com"
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ─────────────────────────── Verification codes ───────────────────────────

model VerificationCode {
  id         String    @id @default(cuid())
  purpose    String    // SIGNUP | RESET
  target     String    // lowercased email the code was sent to
  codeHash   String
  payload    Json?     // SIGNUP: the hashed signup payload awaiting verification
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, purpose])
}

// ─────────────────────────── Coupons ───────────────────────────

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  kind        String   @default("PRO_MONTHS") // PRO_MONTHS | LIFETIME | PERCENT
  value       Int      @default(1) // months for PRO_MONTHS, 0 for LIFETIME, percent for PERCENT
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  active      Boolean  @default(true)
  expiresAt   DateTime?
  note        String?
  createdAt   DateTime @default(now())

  redemptions Redemption[]
  orders      Order[]

  @@index([active])
}

model Redemption {
  id         String   @id @default(cuid())
  couponId   String
  userId     String
  createdAt  DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
}

// ─────────────────────────── Curriculum ───────────────────────────

model Subject {
  code          String @id // MATH | PHYS | CHEM | CH_HUM | CH_SCI
  nameEn        String
  nameZh        String
  shortEn       String
  kind          String // FUNDAMENTAL | CHINESE
  durationMin   Int
  questionCount Int
  totalMarks    Int
  language      String // en+zh | zh
  blurbEn       String
  blurbZh       String
  accent        String @default("ink")

  topics    Topic[]
  questions Question[]
  mocks     Mock[]
}

model Topic {
  id          String  @id @default(cuid())
  code        String  @unique // M1.1
  subjectCode String
  unitEn      String
  unitZh      String
  titleEn     String
  titleZh     String
  summaryEn   String?
  summaryZh   String?
  weight      Float   @default(0) // approx. share of paper
  order       Int

  subject   Subject    @relation(fields: [subjectCode], references: [code], onDelete: Cascade)
  questions Question[]

  @@index([subjectCode, order])
}

// ─────────────────────────── Questions ───────────────────────────

model Question {
  id            String   @id @default(cuid())
  subjectCode   String
  topicId       String
  difficulty    String   @default("MEDIUM") // EASY | MEDIUM | HARD
  stem          String
  stemZh        String?
  options       String[]
  optionsZh     String[] @default([])
  figure        String? // path to an official diagram under /public
  correctIndex  Int
  explanation   String
  explanationZh String?
  tags          String[] @default([])
  source        String   @default("CSCA Master original")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  subject   Subject    @relation(fields: [subjectCode], references: [code], onDelete: Cascade)
  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  mockItems MockItem[]
  reviews   ReviewItem[]

  @@index([subjectCode, difficulty])
  @@index([topicId])
}

// ─────────────────────────── Mocks ───────────────────────────

model Mock {
  id            String   @id @default(cuid())
  slug          String   @unique
  subjectCode   String
  title         String
  titleZh       String?
  subtitle      String?
  subtitleZh    String?
  year          Int      @default(2027)
  paper         String?
  durationMin   Int
  questionCount Int
  isFullLength  Boolean  @default(true)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())

  subject  Subject    @relation(fields: [subjectCode], references: [code], onDelete: Cascade)
  items    MockItem[]
  attempts Attempt[]

  @@index([subjectCode])
}

model MockItem {
  id         String @id @default(cuid())
  mockId     String
  questionId String
  order      Int

  mock     Mock     @relation(fields: [mockId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([mockId, questionId])
  @@index([mockId, order])
}

// ─────────────────────────── Attempts ───────────────────────────

model Attempt {
  id              String    @id @default(cuid())
  userId          String
  mockId          String
  /** Teaching section the paper was started from: EN | ZH. */
  track           String    @default("EN")
  status          String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED
  answers         Json      @default("{}")
  flagged         String[]  @default([])
  totalQuestions  Int       @default(0)
  answeredCount   Int       @default(0)
  rawScore        Int       @default(0)
  score           Int       @default(0)
  topicBreakdown  Json?
  timePerQuestion Json?
  startedAt       DateTime  @default(now())
  lastSavedAt     DateTime  @default(now())
  completedAt     DateTime?
  durationSec     Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mock Mock @relation(fields: [mockId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([mockId])
}

model ReviewItem {
  id           String   @id @default(cuid())
  userId       String
  questionId   String
  correctCount Int      @default(0)
  wrongCount   Int      @default(0)
  streak       Int      @default(0)
  bookmarked   Boolean  @default(false)
  note         String?
  lastSeenAt   DateTime @default(now())
  nextReviewAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
  @@index([userId, bookmarked])
}

// ─────────────────────────── Study plan ───────────────────────────

model PlanTask {
  id        String    @id @default(cuid())
  userId    String
  phase     String // FOUNDATION | INTENSIFICATION | SPRINT
  title     String
  detail    String?
  dueDate   DateTime?
  done      Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, phase, order])
}

// ─────────────────────────── Engagement ───────────────────────────

/// One row per user per day when they complete the daily quiz. Drives streaks
/// and feeds the leaderboard. The quiz itself is deterministic (date-seeded)
/// so we don't store the question set.
model DailyQuizCompletion {
  id          String   @id @default(cuid())
  userId      String
  /// Canonical UTC date key, YYYY-MM-DD.
  date        String
  /// null = mixed subjects
  subjectCode String?
  correct     Int
  total       Int
  score       Int      // 0-100 scaled
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([userId, completedAt])
}

/// Daily rollup of practice activity (drills, quick, review, daily quiz) for
/// time-windowed leaderboards. Upserted per user per day.
model PracticeActivity {
  id                String   @id @default(cuid())
  userId            String
  date              String   // YYYY-MM-DD (UTC)
  questionsAnswered Int      @default(0)
  correct           Int      @default(0)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date, questionsAnswered])
  @@index([userId, date])
}

// ─────────────────────────── Exam calendar ───────────────────────────

model ExamDate {
  id                String   @id @default(cuid())
  examDate          DateTime
  registrationOpen  DateTime?
  registrationClose DateTime?
  formats           String[] @default(["home-online"])
  regionNote        String?
  intake            String   @default("September 2027")
  note              String?
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  whatsapp  String?
  country   String?
  goal      String?
  message   String?
  source    String   @default("site")
  status    String   @default("NEW") // NEW | CONTACTED | CONVERTED | CLOSED
  priority  String   @default("P3") // P1 | P2 | P3
  tags      String[] @default([])
  assignedTo String?
  note      String?
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────── Payments (EPay) ───────────────────────────

model PaymentMethod {
  id            String   @id @default(cuid())
  uuid          String   @unique
  name          String
  gateway       String   @default("EPAY") // EPAY
  icon          String?
  notifyDomain  String?
  feePercent    Float    @default(0)
  feeFixedCents Int      @default(0)
  enable        Boolean  @default(true)
  sort          Int      @default(0)
  gatewayUrl    String
  merchantId    String
  secretKey     String
  paymentType   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@index([enable, sort])
}

model Order {
  id                String    @id @default(cuid())
  tradeNo           String    @unique
  userId            String
  plan              String    // PRO | LIFETIME
  durationMonths    Int       @default(12)
  baseAmountCents   Int
  discountCents     Int       @default(0)
  handlingFeeCents  Int       @default(0)
  totalAmountCents  Int
  currency          String    @default("CNY")
  status            String    @default("PENDING") // PENDING | PAID | CANCELLED
  gateway           String    @default("EPAY")
  paymentMethodId   String?
  paymentMethodName String?
  paymentType       String?
  couponId          String?
  couponCode        String?
  callbackNo        String?
  payUrl            String?
  paidAt            DateTime?
  notifyPayload     Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  coupon        Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentMethodId])
}

model BillingConfig {
  id                String   @id @default("default")
  proPriceCents     Int      @default(9900)
  proDurationMonths Int      @default(12)
  updatedAt         DateTime @updatedAt
}
