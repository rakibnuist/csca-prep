generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── People ───────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String?
  role         String   @default("STUDENT") // STUDENT | ADMIN
  country      String?
  whatsapp     String?
  track        String? // HUMANITIES | STEM
  targetYear   Int      @default(2027)
  testLanguage String   @default("en") // interface language: en | zh
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attempts          Attempt[]
  reviews           ReviewItem[]
  savedUniversities SavedUniversity[]
  planTasks         PlanTask[]

  @@index([createdAt])
}

// ─────────────────────────── Curriculum ───────────────────────────

model Subject {
  code          String @id // MATH | PHYS | CHEM | CH_HUM | CH_SCI
  nameEn        String
  nameZh        String
  shortEn       String
  kind          String // FUNDAMENTAL | CHINESE
  durationMin   Int
  questionCount Int
  totalMarks    Int
  language      String // en+zh | zh
  blurbEn       String
  blurbZh       String
  accent        String @default("ink")

  topics    Topic[]
  questions Question[]
  mocks     Mock[]
}

model Topic {
  id          String  @id @default(cuid())
  code        String  @unique // M1.1
  subjectCode String
  unitEn      String
  unitZh      String
  titleEn     String
  titleZh     String
  summaryEn   String?
  summaryZh   String?
  weight      Float   @default(0) // approx. share of paper
  order       Int

  subject   Subject    @relation(fields: [subjectCode], references: [code], onDelete: Cascade)
  questions Question[]

  @@index([subjectCode, order])
}

// ─────────────────────────── Questions ───────────────────────────

model Question {
  id            String   @id @default(cuid())
  subjectCode   String
  topicId       String
  difficulty    String   @default("MEDIUM") // EASY | MEDIUM | HARD
  stem          String
  stemZh        String?
  options       String[]
  optionsZh     String[] @default([])
  correctIndex  Int
  explanation   String
  explanationZh String?
  tags          String[] @default([])
  source        String   @default("CSCA Master original")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  subject   Subject    @relation(fields: [subjectCode], references: [code], onDelete: Cascade)
  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  mockItems MockItem[]
  reviews   ReviewItem[]

  @@index([subjectCode, difficulty])
  @@index([topicId])
}

// ─────────────────────────── Mocks ───────────────────────────

model Mock {
  id            String   @id @default(cuid())
  slug          String   @unique
  subjectCode   String
  title         String
  subtitle      String?
  year          Int      @default(2027)
  paper         String?
  durationMin   Int
  questionCount Int
  isFullLength  Boolean  @default(true)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())

  subject  Subject    @relation(fields: [subjectCode], references: [code], onDelete: Cascade)
  items    MockItem[]
  attempts Attempt[]

  @@index([subjectCode])
}

model MockItem {
  id         String @id @default(cuid())
  mockId     String
  questionId String
  order      Int

  mock     Mock     @relation(fields: [mockId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([mockId, questionId])
  @@index([mockId, order])
}

// ─────────────────────────── Attempts ───────────────────────────

model Attempt {
  id              String    @id @default(cuid())
  userId          String
  mockId          String
  status          String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED
  answers         Json      @default("{}")
  flagged         String[]  @default([])
  totalQuestions  Int       @default(0)
  answeredCount   Int       @default(0)
  rawScore        Int       @default(0)
  score           Int       @default(0)
  topicBreakdown  Json?
  timePerQuestion Json?
  startedAt       DateTime  @default(now())
  lastSavedAt     DateTime  @default(now())
  completedAt     DateTime?
  durationSec     Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mock Mock @relation(fields: [mockId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([mockId])
}

model ReviewItem {
  id           String   @id @default(cuid())
  userId       String
  questionId   String
  correctCount Int      @default(0)
  wrongCount   Int      @default(0)
  streak       Int      @default(0)
  lastSeenAt   DateTime @default(now())
  nextReviewAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
}

// ─────────────────────────── Study plan ───────────────────────────

model PlanTask {
  id        String    @id @default(cuid())
  userId    String
  phase     String // FOUNDATION | INTENSIFICATION | SPRINT
  title     String
  detail    String?
  dueDate   DateTime?
  done      Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, phase, order])
}

// ─────────────────────────── Universities ───────────────────────────

model University {
  id                  String   @id @default(cuid())
  slug                String   @unique
  nameEn              String
  nameZh              String
  city                String
  province            String?
  tier                String[] @default([]) // 985 | 211 | DFC | CSCA_CENTRE
  languages           String[] @default([]) // Chinese | English
  needsChineseTest    Boolean  @default(true)
  scienceSubjectRule  String   @default("MATH + at least one of PHYS/CHEM")
  humanitiesRule      String   @default("MATH only")
  englishRequirement  String?
  hskRequirement      String?
  applicationDeadline String?
  scholarship         Boolean  @default(true)
  website             String?
  summary             String?
  popularMajors       String[] @default([])
  internationalCount  Int?
  rank                Int?
  verified            Boolean  @default(false)
  lastVerified        DateTime @default(now())

  savedBy SavedUniversity[]

  @@index([city])
  @@index([rank])
}

model SavedUniversity {
  userId       String
  universityId String
  note         String?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@id([userId, universityId])
}

// ─────────────────────────── Exam calendar ───────────────────────────

model ExamDate {
  id                String   @id @default(cuid())
  examDate          DateTime
  registrationOpen  DateTime?
  registrationClose DateTime?
  formats           String[] @default(["home-online"])
  regionNote        String?
  intake            String   @default("September 2027")
  note              String?
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  whatsapp  String?
  country   String?
  goal      String?
  message   String?
  source    String   @default("site")
  createdAt DateTime @default(now())
}
